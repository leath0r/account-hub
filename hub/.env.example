# Токен бота от @BotFather
BOT_TOKEN=
# Свой api_id / api_hash: my.telegram.org → API development tools (не публичная пара Telegram Desktop)
API_ID=
API_HASH=
# Админы — id в Telegram через пробел или запятую. Можно оставить пустым и стать админом через /claim <код из лога>
ADMIN_IDS=
# Часовой пояс для времени сообщений, часы от UTC (Москва = 3)
TZ_OFFSET=3
# Сколько новых переписок («Написать первым») аккаунт может начать за сутки. 0 — без лимита
NEW_CHATS_PER_DAY=20
# Прокси до Telegram, если он заблокирован у провайдера (ставится командой hubctl proxy set)
# PROXY=socks5://127.0.0.1:10808
# SESSION_KEY бот допишет сам при первом запуске. Потерять его = перелогинить все аккаунты.

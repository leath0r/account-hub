[Unit]
Description=Account Hub — клиент прокси: SOCKS5 127.0.0.1:10808 → свой VPN (Telegram заблокирован у провайдера)
ConditionDirectoryNotEmpty=%h/.config/accounthub-proxy
After=network-online.target

[Service]
ExecStart=/bin/bash %h/accounthub/deploy/proxy-run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

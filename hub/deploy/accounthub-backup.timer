[Unit]
Description=Account Hub — бэкап базы раз в сутки

[Timer]
# 04:30 по часам сервера. Своё время/пояс — drop-in, который выкладка не трогает:
#   ~/.config/systemd/user/accounthub-backup.timer.d/local.conf
#   [Timer]
#   OnCalendar=
#   OnCalendar=*-*-* 04:30:00 Europe/Moscow
OnCalendar=*-*-* 04:30:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
